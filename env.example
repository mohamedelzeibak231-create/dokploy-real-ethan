# Copy this file to ".env" and fill in real values.
# Never commit your actual .env file.

# Required — your bot's token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional — your Discord user ID; the bot DMs this user on auto-mod spam actions
OWNER_ID=

# Optional — path to the SQLite database file (defaults to skullix.db)
DB_PATH=skullix.db
